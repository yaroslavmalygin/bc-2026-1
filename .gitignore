# Временные файлы и исходники данных — в репозиторий не попадают.
# Правило накрывает и clients/NN/calendar.xlsx: это заметки астролога до
# вычистки стоп-слов, в публичный репозиторий им нельзя. Конфиг клиента
# рядом (clients/NN/client.json) коммитится — в нём нет имён.
.tmp/
*.xlsx

# Google OAuth
credentials.json
token.json
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# ОС
.DS_Store
Thumbs.db
desktop.ini

# Node
node_modules/
package-lock.json
